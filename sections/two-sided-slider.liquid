{{ 'content-showcase.css' | asset_url | stylesheet_tag: preload: true }}

{% liquid
  capture two_sided_slider_style
    render 'spacing-style', settings: section.settings
    render 'gap-style', value: section.settings.gap
    echo '--content-showcase-columns: ' | append: section.settings.columns | append: ';'
    echo '--content-showcase-mobile-columns: ' | append: section.settings.mobile_columns | append: ';'
    echo '--content-showcase-tablet-columns: ' | append: section.settings.tablet_columns | append: ';'
    echo '--content-showcase-column-gap: ' | append: section.settings.columns_gap | append: 'px;'
    echo '--content-showcase-tablet-column-gap: ' | append: section.settings.columns_gap | append: 'px;'
    echo '--content-showcase-mobile-column-gap: ' | append: section.settings.columns_gap_mobile | append: 'px;'
    echo '--content-showcase-row-gap: ' | append: section.settings.columns_gap | append: 'px;'
    echo '--content-showcase-tablet-row-gap: ' | append: section.settings.columns_gap | append: 'px;'
    echo '--content-showcase-mobile-row-gap: ' | append: section.settings.columns_gap_mobile | append: 'px;'
    echo '--content-showcase-mobile-card-size: ' | append: section.settings.mobile_card_size | append: ';'
  endcapture
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="
    section
    content-showcase
    two-sided-slider
    section--{{ section.settings.section_width }} section--mobile-{{ section.settings.section_width_mobile | default: section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    spacing-style
    gap-style
  "
  style="{{ two_sided_slider_style }}"
  data-testid="two-sided-slider"
>
  <div class="custom-section-background">
    {% render 'background-media',
      background_media: section.settings.background_media,
      background_video: section.settings.video,
      background_video_position: section.settings.video_position,
      background_image: section.settings.background_image,
      background_image_position: section.settings.background_image_position
    %}
  </div>

  <div
    class="border-style custom-section-content"
    style="{% render 'border-override', settings: section.settings %}"
  >
    {% if section.settings.toggle_overlay %}
      {% render 'overlay', settings: section.settings, layer: '0' %}
    {% endif %}

    <div class="two-sided-slider__inner layout-{{ section.settings.layout_type }}">
      {% content_for 'block', type: '_two-sided-slider-left', id: 'two-sided-slider-left' %}
      {% content_for 'block', type: '_cards', id: 'two-sided-slider-right' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .custom-section-background {
    grid-column: 1 / -1;
  }

  .custom-section-content {
    z-index: var(--layer-flat);
  }

  .two-sided-slider__inner {
    display: grid;
    gap: var(--gap);
  }

  .two-sided-slider__empty {
    min-height: 160px;
    display: grid;
    place-items: center;
    border: 1px dashed rgb(var(--color-foreground-rgb) / 0.3);
    padding: 24px;
  }

  @media screen and (min-width: 990px) {
    .two-sided-slider__inner {
      grid-template-columns: minmax(300px, 400px) minmax(0, 1fr);
    }
  }
{% endstylesheet %}

