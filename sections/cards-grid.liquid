<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="
    section
    cards-grid
    section--{{ section.settings.section_width }} section--mobile-{{ section.settings.section_width_mobile | default: section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --cards-grid-columns-desktop: {{ section.settings.columns_desktop }};
    --cards-grid-columns-tablet: {{ section.settings.columns_tablet }};
    --cards-grid-columns-mobile: {{ section.settings.columns_mobile }};
    --cards-grid-column-gap-desktop: {{ section.settings.column_gap_desktop }}px;
    --cards-grid-row-gap-desktop: {{ section.settings.row_gap_desktop }}px;
    --cards-grid-column-gap-adaptive: {{ section.settings.column_gap_adaptive }}px;
    --cards-grid-row-gap-adaptive: {{ section.settings.row_gap_adaptive }}px;
  "
  data-testid="cards-grid"
>
  <div class="cards-grid__background">
    {% render 'background-media',
      background_media: section.settings.background_media,
      background_video: section.settings.video,
      background_video_position: section.settings.video_position,
      background_image: section.settings.background_image,
      background_image_position: section.settings.background_image_position
    %}
  </div>

  <div
    class="cards-grid__content border-style"
    style="{% render 'border-override', settings: section.settings %}"
  >
    {% if section.settings.toggle_overlay %}
      {% render 'overlay', settings: section.settings, layer: '0' %}
    {% endif %}

    <div class="cards-grid__items">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .cards-grid__items {
    display: grid;
    grid-template-columns: repeat(var(--cards-grid-columns-mobile), minmax(0, 1fr));
    column-gap: var(--cards-grid-column-gap-adaptive);
    row-gap: var(--cards-grid-row-gap-adaptive);
  }

  @media screen and (min-width: 576px) {
    .cards-grid__items {
      grid-template-columns: repeat(var(--cards-grid-columns-tablet), minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1024px) {
    .cards-grid__items {
      grid-template-columns: repeat(var(--cards-grid-columns-desktop), minmax(0, 1fr));
      column-gap: var(--cards-grid-column-gap-desktop);
      row-gap: var(--cards-grid-row-gap-desktop);
    }

  }
{% endstylesheet %}

