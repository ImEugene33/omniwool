

{% liquid
  assign render_section = true
  assign is_faq_section = false
  assign section_id = section.id | downcase

  if section_id contains 'faq'
    assign is_faq_section = true
  endif
%}

{% capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% liquid
  assign has_accordion = false
  assign has_non_empty_accordion_row = false

  if children contains 'accordion--cards'
    assign has_accordion = true
  endif

  if children contains 'data-faq-accordion-row'
    assign has_non_empty_accordion_row = true
  endif

  if has_accordion and has_non_empty_accordion_row == false
    assign render_section = false
  endif

  if is_faq_section and has_non_empty_accordion_row == false
    assign render_section = false
  endif
%}

{% if render_section %}
  {% render 'section', section: section, children: children, has_accordion: has_accordion %}
{% endif %}

