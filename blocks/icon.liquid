{% assign block_settings = block.settings %}
{% assign icon_block_class = 'icon-block__media icon-block-' | append: block.id %}

{% liquid
  assign label_flex_direction = 'row'
  assign label_align_items = block_settings.horizontal_alignment

  if block_settings.label_layout == 'vertical'
    assign label_flex_direction = 'column'
    assign label_align_items = block_settings.vertical_alignment
  endif

  if block_settings.label_position == 'before'
    if block_settings.label_layout == 'vertical'
      assign label_flex_direction = 'column-reverse'
    else
      assign label_flex_direction = 'row-reverse'
    endif
  endif
%}

{% capture icon %}
  {% render 'icon-or-image',
    icon: block_settings.icon,
    image_upload: block_settings.image_upload,
    width: block_settings.width,
    class_name: icon_block_class
  %}
{% endcapture %}

{% capture content %}
  <div
    class="icon-block__content"
    style="
      --icon-label-flex-direction: {{ label_flex_direction }};
      --icon-label-align-items: {{ label_align_items }};
      --icon-label-font: {{ block_settings.label_font }};
      --icon-label-gap: {{ block_settings.gap }}px;
      --icon-label-padding-block-start: {{ block_settings.padding_top }}px;
      --icon-label-padding-block-end: {{ block_settings.padding_bottom }}px;
    "
    {{ block.shopify_attributes }}
  >
    {{ icon }}

    {% if block_settings.label != blank %}
      <div class="icon-block__label">{{ block_settings.label }}</div>
    {% endif %}
  </div>
{% endcapture %}

{%- if block_settings.link != blank -%}
  <a
    href="{{ block_settings.link }}"
    class="icon-block__link text-inherit"
    {% if block_settings.open_in_new_tab %}
      target="_blank" rel="noopener"
    {% endif %}
  >
    {{ content }}
  </a>
{%- else -%}
  {{ content }}
{%- endif -%}

{% stylesheet %}
  .icon-block {
    display: inline-flex;
    flex-shrink: 0;
  }

  .icon-block__link {
    display: flex;
    width: 100%;
  }

  .icon-block__content {
    display: flex;
    width: 100%;
    flex-direction: var(--icon-label-flex-direction);
    align-items: var(--icon-label-align-items);
    gap: var(--icon-label-gap);
    padding-block: var(--icon-label-padding-block-start) var(--icon-label-padding-block-end);
  }

  .icon-block__label {
    font-family: var(--icon-label-font);
  }

  .icon-block__label > * {
    margin: 0;
  }

  .icon-block__media {
    height: auto;
    flex-shrink: 0;
  }
{% endstylesheet %}

