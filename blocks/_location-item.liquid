{% capture children %}
  {% content_for 'blocks' %}
{% endcapture %}
{% assign children_content = children | strip %}
{% assign has_link = false %}
{% if block.settings.link != blank and block.settings.link_label != blank %}
  {% assign has_link = true %}
{% endif %}

<article class="location-item location-item-{{ block.id }}" {{ block.shopify_attributes }}>
  {% if block.settings.map_embed != blank %}
    <div class="location-item__map">
      {{ block.settings.map_embed }}
    </div>
  {% endif %}

  <div class="location-item__content">
    {% if block.settings.title != blank or has_link %}
      <div class="location-item__header">
        {% if block.settings.title != blank %}
          <h3>{{ block.settings.title | escape }}</h3>
        {% endif %}

        {% if has_link %}
          <a class="button button-secondary" href="{{ block.settings.link }}">
            {{ block.settings.link_label | escape }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if children_content != blank %}
      <div class="location-item__blocks">
        {{ children }}
      </div>
    {% endif %}
  </div>
</article>

{% schema %}
{
  "name": "Location item",
  "tag": null,
  "blocks": [
    {
      "type": "group-text"
    },
    {
      "type": "icon"
    }
  ],
  "settings": [
    {
      "type": "liquid",
      "id": "map_embed",
      "label": "Google map embed"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Location title"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Get directions"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Location item",
      "category": "Custom"
    }
  ]
}
{% endschema %}
