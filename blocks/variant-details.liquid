{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product

  if product_resource != blank and product_resource.has_only_default_variant == false
    assign selected_variant = product_resource.selected_or_first_available_variant

    if selected_variant == blank
      assign selected_variant = product_resource.variants.first
    endif
  endif
-%}

{% capture variant_details %}
  {%- liquid
    assign has_variant_detail = false

    for option_value in selected_variant.options
      assign option_value = option_value | strip

      if option_value != blank and option_value != 'Default Title' and option_value != 'Central Texas'
        if has_variant_detail
          echo ' · '
        endif

        echo option_value
        assign has_variant_detail = true
      endif
    endfor
  -%}
{% endcapture %}

{%- liquid
  assign variant_details = variant_details | strip

  if variant_details == blank
    assign variant_title = selected_variant.title | strip

    if variant_title != blank and variant_title != 'Default Title'
      assign variant_details = variant_title | remove: 'Central Texas / ' | remove: ' / Central Texas' | replace: ' / ', ' · '
    endif
  endif
-%}

{% liquid
  if block_settings.type_preset == 'rte' or block_settings.type_preset == 'paragraph'
    assign is_rte = true
  endif

  capture text_block_classes
    if block_settings.width == '100%'
      echo 'text-block--align-' | append: block_settings.alignment
      if block_settings.max_width == 'none'
        echo ' text-block--full-width'
      endif
    endif
    if block_settings.type_preset == 'custom'
      echo ' custom-typography'
      if block_settings.font_size != ''
        echo ' custom-font-size'
      endif
      if block_settings.color != ''
        echo ' custom-color'
      endif
    endif
    if is_rte
      echo ' rte'
    endif
  endcapture
%}

{% if variant_details != blank %}
  <div
    class="text-block {{ text_block_classes }} text-{{ block_settings.alignment }} {{ block_settings.type_preset | default: 'paragraph' }} spacing-style"
    style="
      {% render 'typography-style', settings: block_settings %}
      {% render 'spacing-style', settings: block_settings %}
      --width: {{ block_settings.width }};
    "
    {{ block.shopify_attributes }}
  >
    {{ variant_details }}
  </div>
{% endif %}

