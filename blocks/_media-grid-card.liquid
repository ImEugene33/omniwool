{% liquid
  assign block_settings = block.settings
%}

<article class="media-grid-card" {{ block.shopify_attributes }}>
  {% if block_settings.image != blank %}
    {{
      block_settings.image
      | image_url: width: 1600
      | image_tag:
        class: 'media-grid-card__image',
        widths: '360, 540, 720, 960, 1200, 1600',
        sizes: '(min-width: 990px) 50vw, 100vw',
        loading: 'lazy'
    }}
  {% else %}
    <div class="media-grid-card__placeholder">
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
    </div>
  {% endif %}

  <div class="media-grid-card__content">
    <div class="media-grid-card__copy">
      {% if block_settings.title != blank %}
        <h3 class="media-grid-card__title">{{ block_settings.title | escape }}</h3>
      {% endif %}

      {% if block_settings.text != blank %}
        <p class="media-grid-card__text">{{ block_settings.text | escape }}</p>
      {% endif %}
    </div>

    {% if block_settings.link_label != blank and block_settings.link != blank %}
      <a class="media-grid-card__link" href="{{ block_settings.link | escape }}">
        {{ block_settings.link_label | escape }}
        <span aria-hidden="true">&rarr;</span>
      </a>
    {% endif %}
  </div>
</article>

{% schema %}
{
  "name": "Media grid card",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed ut rutrum ligula."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button label",
      "default": "Button label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Media grid card"
    }
  ]
}
{% endschema %}
