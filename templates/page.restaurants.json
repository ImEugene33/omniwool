                    "padding-inline-start": 0,
                    "padding-inline-end": 0,
                    "padding-block-start-mobile": 0,
                    "padding-block-end-mobile": 0,
                    "padding-inline-start-mobile": 0,
                    "padding-inline-end-mobile": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_niBtPk"
              ]
            },
            "accordion_row_HqLYyn": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "What is the difference between wood splits and wood chips or chunks?",
                "content": "",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_JBFpmF": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Splits are full-size<br/>pieces built for offset smokers and high-volume commercial smokers, where they hold sustained<br/>heat and smoke through a long cook. Smaller chunks and wood chips give finer control on<br/>shorter cooks and suit a pellet smoker or electric smoker. Tell us how you cook and we will point<br/>you to the right size.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "weight": "",
                    "weight_active": "inherit",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "color": "var(--color-foreground)",
                    "background": false,
                    "background_color": "#00000026",
                    "text_color": "#000000",
                    "active_color": "#d23d00",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0,
                    "padding-block-start-mobile": 0,
                    "padding-block-end-mobile": 0,
                    "padding-inline-start-mobile": 0,
                    "padding-inline-end-mobile": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_JBFpmF"
              ]
            },
            "accordion_row_Hzx8BC": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "How much smoking wood does a restaurant go through?",
                "content": "",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_f4yqKc": {
                  "type": "text",
                  "settings": {
                    "text": "<p>It varies with your menu, your<br/>smoker, and your service volume, which is exactly why we plan around your burn rate. We track<br/>your usage with you and schedule recurring deliveries so a busy weekend never leaves you<br/>short.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "weight": "",
                    "weight_active": "inherit",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "color": "var(--color-foreground)",
                    "background": false,
                    "background_color": "#00000026",
