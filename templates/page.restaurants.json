            "container_size": "small",
            "show_borders": false,
            "use_product_faq_metafield": true,
            "row_color_scheme": "scheme-0c2ea821-4e44-4805-9146-bbdd95689162",
            "open_row_color_scheme": "scheme-5",
            "row_border_radius": 4,
