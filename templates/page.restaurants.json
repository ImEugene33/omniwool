                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0,
                    "padding-block-start-mobile": 0,
                    "padding-block-end-mobile": 0,
                    "padding-inline-start-mobile": 0,
                    "padding-inline-end-mobile": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_f4yqKc"
              ]
            },
            "accordion_row_MRkxgi": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Do you deliver cooking wood in bulk or by the truckload?",
                "content": "",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_WfJQD9": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. We deliver everything from<br/>single pallets to full truckloads, with volume discounts on larger orders, and we ship nationwide.<br/>In-house trucking lets us schedule recurring deliveries around your burn rate.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "weight": "",
                    "weight_active": "inherit",
                    "line_height": "normal",
