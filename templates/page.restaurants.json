                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0,
                    "padding-block-start-mobile": 0,
                    "padding-block-end-mobile": 0,
                    "padding-inline-start-mobile": 0,
                    "padding-inline-end-mobile": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_WfJQD9"
              ]
            },
            "accordion_row_LdFV4J": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Where does ButlerWood deliver?",
                "content": "",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_nXHxwx": {
                  "type": "text",
                  "settings": {
                    "text": "<p>We operate two yards in Texas, in Seguin and Gonzales,<br/>and deliver to restaurants and businesses in every state, with international shipping available on<br/>request. Reach out for a quote on bulk or recurring orders.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "weight": "",
                    "weight_active": "inherit",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
